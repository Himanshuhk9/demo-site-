<style>
  :root{
    --white:#ffffff;
    --bg-soft:#F3F8FC;
    --bg-softer:#EAF3FA;
    --primary-900:#073763;
    --primary-700:#0F5C97;
    --primary-600:#1571B5;
    --accent-cyan:#2FA8E0;
    --accent-green:#1E9E6B;
    --accent-red:#E1483C;
    --text-dark:#132635;
    --text-muted:#5C7286;
    --border-soft:#DCEAF4;
    --radius-sm:10px;
    --radius-md:16px;
    --radius-lg:26px;
    --shadow-soft:0 10px 30px rgba(15,92,151,0.10);
    --shadow-strong:0 18px 45px rgba(7,55,99,0.18);
    --font-display:'Fraunces', serif;
    --font-body:'Inter', sans-serif;
  }

  *,*::before,*::after{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:var(--font-body);
    color:var(--text-dark);
    background:var(--white);
    -webkit-font-smoothing:antialiased;
    line-height:1.6;
  }
  img{max-width:100%;display:block;}
  a{color:inherit;text-decoration:none;}
  ul{list-style:none;margin:0;padding:0;}
  h1,h2,h3,h4{font-family:var(--font-display);margin:0;color:var(--primary-900);line-height:1.15;}
  p{margin:0;}
  .container{max-width:1180px;margin:0 auto;padding:0 24px;}
  section{position:relative;}
  .eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    font-family:var(--font-body);font-weight:700;font-size:0.75rem;
    letter-spacing:0.14em;text-transform:uppercase;
    color:var(--primary-700);
    margin-bottom:14px;
  }
  .eyebrow::before{content:"";width:22px;height:2px;background:var(--accent-cyan);display:inline-block;border-radius:2px;}
  .section-head{max-width:640px;margin:0 auto 48px;text-align:center;}
  .section-head h2{font-size:clamp(1.7rem,3.2vw,2.4rem);font-weight:600;}
  .section-head p{color:var(--text-muted);margin-top:14px;font-size:1.02rem;}
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:8px;
    padding:14px 26px;border-radius:100px;font-weight:700;font-size:0.95rem;
    border:2px solid transparent;cursor:pointer;transition:transform .18s ease, box-shadow .18s ease, background .18s ease, color .18s ease;
    white-space:nowrap;
  }
  .btn svg{width:18px;height:18px;flex-shrink:0;}
  .btn-primary{background:var(--accent-red);color:#fff;box-shadow:0 10px 24px rgba(225,72,60,0.35);}
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(225,72,60,0.42);}
  .btn-outline{background:transparent;border-color:rgba(255,255,255,0.55);color:#fff;}
  .btn-outline:hover{background:rgba(255,255,255,0.12);transform:translateY(-2px);}
  .btn-solid-blue{background:var(--primary-700);color:#fff;box-shadow:0 10px 24px rgba(15,92,151,0.3);}
  .btn-solid-blue:hover{transform:translateY(-2px);background:var(--primary-900);}
  .btn-ghost-blue{background:var(--bg-soft);color:var(--primary-700);border-color:var(--border-soft);}
  .btn-ghost-blue:hover{background:var(--bg-softer);transform:translateY(-2px);}

  /* ---------- Header ---------- */
  .site-header{
    position:sticky;top:0;z-index:200;
    background:rgba(255,255,255,0.92);
    backdrop-filter:blur(10px);
    border-bottom:1px solid transparent;
    transition:box-shadow .25s ease, border-color .25s ease;
  }
  .site-header.scrolled{box-shadow:0 6px 24px rgba(7,55,99,0.08);border-bottom-color:var(--border-soft);}
  .nav-wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;}
  .brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:700;font-size:1.25rem;color:var(--primary-900);}
  .brand-mark{
    width:40px;height:40px;border-radius:11px;background:linear-gradient(145deg,var(--primary-700),var(--primary-900));
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .brand-mark svg{width:20px;height:20px;}
  .brand small{display:block;font-family:var(--font-body);font-weight:600;font-size:0.62rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--text-muted);}
  .nav-links{display:flex;align-items:center;gap:30px;}
  .nav-links a{font-weight:600;font-size:0.93rem;color:var(--text-dark);position:relative;padding:6px 0;}
  .nav-links a::after{content:"";position:absolute;left:0;bottom:0;height:2px;width:0;background:var(--accent-cyan);transition:width .2s ease;}
  .nav-links a:hover::after{width:100%;}
  .nav-actions{display:flex;align-items:center;gap:14px;}
  .call-pill{
    display:flex;align-items:center;gap:8px;background:var(--primary-900);color:#fff;
    padding:10px 18px;border-radius:100px;font-weight:700;font-size:0.9rem;
  }
  .call-pill svg{width:16px;height:16px;}
  .nav-toggle{display:none;background:none;border:none;cursor:pointer;padding:6px;}
  .nav-toggle span{display:block;width:24px;height:2.4px;background:var(--primary-900);margin:5px 0;border-radius:2px;transition:.25s;}

  /* ---------- Hero ---------- */
  .hero{
    background:radial-gradient(circle at 82% 18%, rgba(47,168,224,0.16), transparent 55%),
               linear-gradient(180deg,var(--bg-soft) 0%, #ffffff 100%);
    padding:64px 0 40px;overflow:hidden;
  }
  .hero-grid{display:grid;grid-template-columns:1.1fr 0.9fr;gap:56px;align-items:center;}
  .badge-24{
    display:inline-flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--border-soft);
    padding:8px 16px 8px 10px;border-radius:100px;box-shadow:var(--shadow-soft);font-weight:700;font-size:0.82rem;color:var(--primary-900);margin-bottom:20px;
  }
  .pulse-dot{width:10px;height:10px;border-radius:50%;background:var(--accent-red);position:relative;flex-shrink:0;}
  .pulse-dot::after{content:"";position:absolute;inset:-5px;border-radius:50%;border:2px solid var(--accent-red);animation:pulseRing 1.8s infinite ease-out;}
  @keyframes pulseRing{0%{transform:scale(0.6);opacity:0.9;}100%{transform:scale(2.1);opacity:0;}}
  .hero h1{font-size:clamp(2.3rem,4.6vw,3.6rem);font-weight:700;letter-spacing:-0.01em;}
  .hero .tagline{font-family:var(--font-display);font-weight:500;font-style:italic;font-size:clamp(1.15rem,2vw,1.45rem);color:var(--primary-700);margin-top:12px;}
  .hero p.lead{color:var(--text-muted);font-size:1.05rem;margin-top:20px;max-width:520px;}
  .hero-actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px;}
  .hero-chips{display:flex;flex-wrap:wrap;gap:22px;margin-top:40px;}
  .hero-chip{display:flex;align-items:center;gap:10px;font-size:0.88rem;font-weight:600;color:var(--text-dark);}
  .hero-chip .ic{width:34px;height:34px;border-radius:9px;background:var(--bg-softer);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .hero-chip svg{width:17px;height:17px;color:var(--primary-700);}

  .hero-visual{position:relative;}
  .hero-card{
    background:linear-gradient(160deg,var(--primary-700),var(--primary-900));
    border-radius:var(--radius-lg);padding:34px;color:#fff;box-shadow:var(--shadow-strong);position:relative;overflow:hidden;
  }
  .hero-card::before{content:"";position:absolute;top:-40px;right:-40px;width:180px;height:180px;border-radius:50%;background:rgba(255,255,255,0.08);}
  .ecg-line{width:100%;height:56px;margin:18px 0 6px;}
  .ecg-line path{fill:none;stroke:var(--accent-cyan);stroke-width:3;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:1000;stroke-dashoffset:1000;animation:draw 3.2s ease-in-out infinite;}
  @keyframes draw{
    0%{stroke-dashoffset:1000;}
    55%{stroke-dashoffset:0;}
    100%{stroke-dashoffset:-1000;}
  }
  .hero-card h3{color:#fff;font-size:1.3rem;font-weight:600;}
  .hero-card p{color:rgba(255,255,255,0.78);font-size:0.92rem;margin-top:8px;}
  .hero-card .divider{height:1px;background:rgba(255,255,255,0.18);margin:22px 0;}
  .mini-stats{display:flex;gap:18px;}
  .mini-stat{flex:1;}
  .mini-stat .num{font-family:var(--font-display);font-size:1.4rem;font-weight:700;color:#fff;}
  .mini-stat .lbl{font-size:0.74rem;color:rgba(255,255,255,0.72);margin-top:2px;}
  .float-badge{
    position:absolute;bottom:-22px;left:-22px;background:#fff;color:var(--primary-900);
    border-radius:var(--radius-md);padding:16px 20px;box-shadow:var(--shadow-strong);
    display:flex;align-items:center;gap:12px;
  }
  .float-badge .ic{width:44px;height:44px;border-radius:12px;background:var(--bg-softer);display:flex;align-items:center;justify-content:center;}
  .float-badge svg{width:22px;height:22px;color:var(--accent-green);}
  .float-badge strong{display:block;font-size:0.95rem;}
  .float-badge span{font-size:0.78rem;color:var(--text-muted);}

  /* ---------- Emergency strip ---------- */
  .emergency-strip{
    background:linear-gradient(90deg,var(--primary-900),var(--primary-700));
    color:#fff;padding:22px 0;
  }
  .emergency-inner{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;}
  .emergency-text{display:flex;align-items:center;gap:14px;}
  .emergency-text svg{width:30px;height:30px;color:var(--accent-cyan);flex-shrink:0;}
  .emergency-text strong{display:block;font-size:1.05rem;font-family:var(--font-display);font-weight:600;}
  .emergency-text span{font-size:0.88rem;color:rgba(255,255,255,0.75);}

  /* ---------- About ---------- */
  .about{padding:96px 0;}
  .about-top{display:grid;grid-template-columns:0.9fr 1.1fr;gap:56px;align-items:center;margin-bottom:64px;}
  .about-top p{color:var(--text-muted);font-size:1.03rem;margin-top:18px;}
  .about-top h2{font-size:clamp(1.8rem,3.4vw,2.5rem);font-weight:600;}
  .about-panel{
    background:var(--bg-soft);border-radius:var(--radius-lg);padding:34px;border:1px solid var(--border-soft);
  }
  .about-panel .row{display:flex;gap:14px;padding:14px 0;border-bottom:1px solid var(--border-soft);}
  .about-panel .row:last-child{border-bottom:none;}
  .about-panel svg{width:22px;height:22px;color:var(--primary-700);flex-shrink:0;margin-top:2px;}
  .about-panel strong{display:block;font-size:0.98rem;}
  .about-panel span{font-size:0.87rem;color:var(--text-muted);}

  .feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;}
  .feature-card{
    background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-md);
    padding:30px 26px;box-shadow:var(--shadow-soft);
    transition:transform .25s ease, box-shadow .25s ease;
  }
  .feature-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-strong);}
  .feature-icon{width:52px;height:52px;border-radius:14px;background:var(--bg-softer);display:flex;align-items:center;justify-content:center;margin-bottom:18px;}
  .feature-icon svg{width:26px;height:26px;color:var(--primary-700);}
  .feature-card h4{font-size:1.1rem;font-weight:600;margin-bottom:8px;}
  .feature-card p{color:var(--text-muted);font-size:0.92rem;}

  /* ---------- reveal animation ---------- */
  .reveal{opacity:0;transform:translateY(28px);transition:opacity .7s ease, transform .7s ease;}
  .reveal.in-view{opacity:1;transform:translateY(0);}

  /* ---------- Divider ---------- */
  .vital-divider{padding:6px 0;background:#fff;}
  .vital-divider svg{width:100%;height:34px;display:block;}
  .vital-divider path{fill:none;stroke:var(--border-soft);stroke-width:2;}

  /* ---------- Services ---------- */
  .services{padding:96px 0;background:var(--bg-soft);}
  .services-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .service-card{
    background:#fff;border-radius:var(--radius-md);padding:30px 26px;border:1px solid var(--border-soft);
    box-shadow:var(--shadow-soft);transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease;position:relative;
  }
  .service-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-strong);border-color:var(--accent-cyan);}
  .service-icon{width:54px;height:54px;border-radius:15px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;
    background:linear-gradient(150deg,var(--primary-700),var(--primary-900));}
  .service-icon svg{width:26px;height:26px;color:#fff;}
  .service-card h4{font-size:1.12rem;font-weight:600;margin-bottom:10px;}
  .service-card p{color:var(--text-muted);font-size:0.92rem;}

  /* ---------- Gallery ---------- */
  .gallery{padding:96px 0;}
  .gallery-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .gallery-tile{
    aspect-ratio:4/3;border-radius:var(--radius-md);position:relative;overflow:hidden;
    background:linear-gradient(150deg,var(--bg-softer),var(--bg-soft));
    border:1px solid var(--border-soft);
    display:flex;align-items:center;justify-content:center;flex-direction:column;gap:10px;
    transition:transform .3s ease;
  }
  .gallery-tile:hover{transform:scale(1.02);}
  .gallery-tile svg{width:34px;height:34px;color:var(--primary-700);opacity:0.55;}
  .gallery-tile span.g-title{font-weight:700;font-size:0.92rem;color:var(--primary-900);}
  .gallery-tile span.g-sub{font-size:0.76rem;color:var(--text-muted);}
  .gallery-tile::before{
    content:"";position:absolute;inset:0;
    background:repeating-linear-gradient(45deg, rgba(15,92,151,0.035) 0 14px, transparent 14px 28px);
  }

  /* ---------- Reviews ---------- */
  .reviews{padding:96px 0;background:var(--bg-soft);}
  .rating-banner{
    display:flex;align-items:center;justify-content:center;gap:22px;flex-wrap:wrap;
    background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);
    padding:28px 36px;box-shadow:var(--shadow-soft);max-width:680px;margin:0 auto 48px;
  }
  .rating-score{text-align:center;}
  .rating-score .num{font-family:var(--font-display);font-size:2.4rem;font-weight:700;color:var(--primary-900);}
  .stars{display:flex;gap:3px;justify-content:center;margin:4px 0;}
  .stars svg{width:18px;height:18px;color:#F5A623;}
  .rating-score span.small{font-size:0.8rem;color:var(--text-muted);}
  .rating-divider{width:1px;height:56px;background:var(--border-soft);}
  .rating-source{font-size:0.9rem;color:var(--text-muted);max-width:220px;}
  .rating-source strong{color:var(--text-dark);display:block;font-size:0.98rem;}

  .testimonial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .testimonial-card{background:#fff;border-radius:var(--radius-md);padding:28px;border:1px solid var(--border-soft);box-shadow:var(--shadow-soft);}
  .testimonial-card .stars{justify-content:flex-start;margin-bottom:14px;}
  .testimonial-card p.quote{color:var(--text-dark);font-size:0.95rem;font-style:italic;}
  .testimonial-foot{display:flex;align-items:center;gap:12px;margin-top:18px;}
  .avatar{width:38px;height:38px;border-radius:50%;background:var(--primary-700);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:0.85rem;flex-shrink:0;}
  .testimonial-foot strong{font-size:0.9rem;display:block;}
  .testimonial-foot span{font-size:0.78rem;color:var(--text-muted);}

  /* ---------- Appointment ---------- */
  .appointment{padding:96px 0;}
  .appt-grid{display:grid;grid-template-columns:1.2fr 0.8fr;gap:40px;}
  .appt-form{
    background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);
    padding:38px;box-shadow:var(--shadow-soft);
  }
  .form-row{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-bottom:18px;}
  .field{display:flex;flex-direction:column;gap:8px;margin-bottom:18px;}
  .field label{font-size:0.83rem;font-weight:700;color:var(--text-dark);}
  .field input,.field select,.field textarea{
    border:1.6px solid var(--border-soft);border-radius:var(--radius-sm);padding:13px 15px;
    font-family:var(--font-body);font-size:0.94rem;color:var(--text-dark);background:var(--bg-soft);
    transition:border-color .18s ease, background .18s ease;
  }
  .field input:focus,.field select:focus,.field textarea:focus{outline:none;border-color:var(--accent-cyan);background:#fff;}
  .field textarea{resize:vertical;min-height:100px;}
  .form-note{font-size:0.8rem;color:var(--text-muted);margin-top:6px;}
  .form-success{
    display:none;align-items:center;gap:12px;background:#EAF9F1;border:1px solid #BEE9D3;color:#1E7A50;
    padding:16px 18px;border-radius:var(--radius-sm);margin-bottom:18px;font-size:0.9rem;font-weight:600;
  }
  .form-success.show{display:flex;}
  .form-success svg{width:20px;height:20px;flex-shrink:0;}

  .appt-side{display:flex;flex-direction:column;gap:20px;}
  .side-card{
    background:linear-gradient(160deg,var(--primary-700),var(--primary-900));color:#fff;
    border-radius:var(--radius-lg);padding:30px;box-shadow:var(--shadow-strong);
  }
  .side-card h4{color:#fff;font-size:1.15rem;font-weight:600;margin-bottom:14px;}
  .side-row{display:flex;gap:12px;align-items:flex-start;margin-bottom:16px;}
  .side-row:last-child{margin-bottom:0;}
  .side-row svg{width:19px;height:19px;color:var(--accent-cyan);flex-shrink:0;margin-top:2px;}
  .side-row strong{display:block;font-size:0.92rem;}
  .side-row span{font-size:0.83rem;color:rgba(255,255,255,0.75);}
  .side-card .btn{margin-top:8px;width:100%;}
  .side-note{
    background:var(--bg-soft);border:1px solid var(--border-soft);border-radius:var(--radius-md);
    padding:22px;font-size:0.86rem;color:var(--text-muted);
  }
  .side-note strong{color:var(--text-dark);display:block;margin-bottom:6px;font-size:0.92rem;}

  /* ---------- Contact ---------- */
  .contact{padding:96px 0;background:var(--bg-soft);}
  .contact-grid{display:grid;grid-template-columns:0.85fr 1.15fr;gap:36px;}
  .contact-card{background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);padding:32px;box-shadow:var(--shadow-soft);}
  .contact-item{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--border-soft);}
  .contact-item:last-child{border-bottom:none;}
  .contact-item .ic{width:40px;height:40px;border-radius:11px;background:var(--bg-softer);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .contact-item svg{width:19px;height:19px;color:var(--primary-700);}
  .contact-item strong{display:block;font-size:0.94rem;}
  .contact-item span{font-size:0.87rem;color:var(--text-muted);}
  .map-wrap{border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-soft);border:1px solid var(--border-soft);min-height:340px;}
  .map-wrap iframe{width:100%;height:100%;min-height:340px;border:0;display:block;}

  /* ---------- Footer ---------- */
  .site-footer{background:var(--primary-900);color:rgba(255,255,255,0.82);padding-top:70px;}
